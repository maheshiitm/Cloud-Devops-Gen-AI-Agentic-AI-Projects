pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Format') {
            steps {
                dir('terraform') {
                    sh 'terraform fmt -check'
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('terraform') {
                    sh 'terraform init -backend=false'
                    sh 'terraform validate'
                }
            }
        }

        stage('Build') {
            steps {
                echo 'Building VMware-to-AWS migration workload'
            }
        }

        stage('Security Review') {
            steps {
                echo 'Run security and compliance checks before deployment'
            }
        }

        stage('Deployment Approval') {
            steps {
                input message: 'Approve deployment to AWS?'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deployment stage approved'
            }
        }
    }

    post {
        always {
            echo 'Pipeline completed'
        }
    }
}
